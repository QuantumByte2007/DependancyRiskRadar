# ── Required ────────────────────────────────────
GEMINI_API_KEY=AIza...

# ── Optional but recommended ─────────────────────
# NVD API key (free at https://nvd.nist.gov/developers/request-an-api-key)
# Increases rate limit from 5 req/30s to 50 req/30s
NVD_API_KEY=

# ── Infrastructure ────────────────────────────────
# Defaults work with docker-compose out of the box
DATABASE_URL=sqlite:////tmp/drr_reports/drr.db
REDIS_URL=redis://localhost:6379/0
OUTPUT_DIR=/tmp/drr_reports

# ── LLM tuning ────────────────────────────────────
LLM_MODEL=gemini-2.0-flash
LLM_MAX_TOKENS=4096
MAX_COMPONENTS_FOR_LLM=30

# ── Risk thresholds ───────────────────────────────
# Score above which a component is flagged as CRITICAL (0-100)
THRESHOLD_CRITICAL=75.0
THRESHOLD_HIGH=50.0
THRESHOLD_MODERATE=20.0

# ── Dev ───────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO
